    protocolo = normalizar_protocolo(protocolo)

    try:
        dados = detalhes_solicitacao(protocolo)

        if not dados:
            return erro_json(
                "Protocolo não encontrado.",
                404
            )

        usuario = usuario_atual()

        if (
            usuario["tipo_usuario"].lower()
            not in {
                "coordenacao",
                "coordenador",
                "admin",
                "administrador"
            }
            and dados["matricula"] != usuario["matricula"]
        ):
            return erro_json(
                "Você não tem permissão para consultar esta solicitação.",
                403
            )

        return jsonify({
            "sucesso": True,
            "dados": dados
        })

    except Error:
        app.logger.exception("Falha ao consultar solicitação.")

        return erro_json(
            "Não foi possível consultar a solicitação.",
            500
        )

