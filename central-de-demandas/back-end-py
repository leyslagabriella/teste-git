}

def conectar_banco():
    return mysql.connector.connect(**DB_CONFIG)

def executar(sql, parametros=(), buscar=None, commit=False):
    conexao = conectar_banco()
    cursor = conexao.cursor(dictionary=True)

    try:
        cursor.execute(sql, parametros)

        if buscar == "um":
            resultado = cursor.fetchone()
        elif buscar == "todos":
            resultado = cursor.fetchall()
        else:
            resultado = cursor.lastrowid

        if commit:
            conexao.commit()

        return resultado

    except Exception:
        if commit:
            conexao.rollback()
        raise

    finally:
        cursor.close()
        conexao.close()

def erro_json(mensagem, status=400):
    return jsonify({
        "sucesso": False,
        "erro": mensagem
    }), status

def usuario_atual():
    return session.get("usuario")

def login_obrigatorio(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        if not usuario_atual():
            return erro_json("Faça login para continuar.", 401)

        return func(*args, **kwargs)

    return wrapper

def coordenacao_obrigatoria(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        usuario = usuario_atual()

        if not usuario:
            return erro_json("Faça login para continuar.", 401)

        if usuario.get("tipo_usuario", "").lower() not in {
            "coordenacao",
            "coordenador",
            "admin",
            "administrador"
        }:
            return erro_json("Acesso restrito à coordenação.", 403)

        return func(*args, **kwargs)

    return wrapper

def normalizar_protocolo(valor):
    valor = str(valor or "").strip()

    if not valor:
        return ""

    return valor if valor.startswith("#") else f"#{valor}"

def gerar_protocolo(cursor):
    ano = datetime.now().year

    cursor.execute(
        """
        SELECT protocolo
        FROM solicitacao
        WHERE protocolo LIKE %s
        ORDER BY id_solicitacao DESC
        LIMIT 1
        """,
        (f"#{ano}-%",)
    )

    registro = cursor.fetchone()

    if registro and registro[0]:
        match = re.search(r"-(\d+)$", registro[0])
        numero = int(match.group(1)) + 1 if match else 1
    else:
        numero = 1

    return f"#{ano}-{numero:03d}"

def buscar_solicitacao(protocolo):
    sql = """
        SELECT
            s.id_solicitacao,
            s.protocolo,
            s.titulo,
            s.descricao,
            s.data_criacao,
            s.prazo,
            s.prioridade,
            u.id_usuarios,
            u.nome AS aluno,
            u.matricula,
            u.curso,
            u.turma,
            c.nome AS categoria,
            st.nome AS status
        FROM solicitacao s
        JOIN usuarios u
            ON u.id_usuarios = s.id_usuario
        LEFT JOIN categorias c
            ON c.id_categorias = s.id_categoria
        LEFT JOIN status_solicitacao st
            ON st.id_status = s.id_status
        WHERE s.protocolo = %s
        LIMIT 1
    """

    return executar(sql, (protocolo,), buscar="um")

def detalhes_solicitacao(protocolo):
    solicitacao = buscar_solicitacao(protocolo)

    if not solicitacao:
        return None

    mensagens = executar(
        """
        SELECT
            m.conteudo AS texto,
            m.data_envio,
            u.nome AS remetente,
            u.tipo_usuario
        FROM mensagens m
        JOIN usuarios u
            ON u.id_usuarios = m.id_usuario
        WHERE m.id_solicitacao = %s
        ORDER BY m.data_envio ASC, m.id_mensagens ASC
        """,
        (solicitacao["id_solicitacao"],),
        buscar="todos"
    ) or []

    anexos = executar(
        """
        SELECT
            id_anexos,
            nome_arquivo,
            tipo_mime,
            tamanho_bytes
        FROM anexos
        WHERE id_solicitacao = %s
        ORDER BY id_anexos ASC
        """,
        (solicitacao["id_solicitacao"],),
        buscar="todos"
    ) or []

    historico = executar(
        """
        SELECT
            h.data_alteracao,
            h.observacao,
            st.nome AS status,
            u.nome AS responsavel
        FROM historico_status h
        LEFT JOIN status_solicitacao st
            ON st.id_status = h.id_status
        LEFT JOIN usuarios u
            ON u.id_usuarios = h.id_usuario
        WHERE h.id_solicitacao = %s
        ORDER BY h.data_alteracao ASC, h.id_historico ASC
        """,
        (solicitacao["id_solicitacao"],),
        buscar="todos"
    ) or []

    return {
        "codigo": solicitacao["protocolo"],
        "id_solicitacao": solicitacao["id_solicitacao"],
        "titulo": solicitacao["titulo"],
        "descricao": solicitacao["descricao"],
        "aluno": solicitacao["aluno"],
        "matricula": solicitacao["matricula"],
        "curso": solicitacao["curso"],
        "turma": solicitacao["turma"],
        "categoria": solicitacao["categoria"] or "Sem categoria",
        "prioridade": solicitacao["prioridade"],
        "status": solicitacao["status"] or "Recebido",
        "prazo": (
            solicitacao["prazo"].isoformat()
            if solicitacao["prazo"] else None
        ),
        "data_criacao": (
            solicitacao["data_criacao"].isoformat(sep=" ")
            if solicitacao["data_criacao"] else None
        ),
        "mensagens": [
            {
                "remetente": m["remetente"],
                "texto": m["texto"],
                "hora": (
                    m["data_envio"].strftime("%H:%M")
                    if m["data_envio"] else ""
                ),
                "data_envio": (
                    m["data_envio"].isoformat(sep=" ")
                    if m["data_envio"] else None
                )
            }
            for m in mensagens
        ],
        "anexos": [
            {
                "id": a["id_anexos"],
                "nome": a["nome_arquivo"],
                "tipo_mime": a["tipo_mime"],
                "tamanho_bytes": a["tamanho_bytes"],
                "url": f"/api/anexos/{a['id_anexos']}/download"
            }
            for a in anexos
        ],
        "historico": [
            {
                "status": h["status"],
                "observacao": h["observacao"],
                "responsavel": h["responsavel"],
                "data": (
                    h["data_alteracao"].isoformat(sep=" ")
                    if h["data_alteracao"] else None
                )
            }
            for h in historico
        ]
    }

