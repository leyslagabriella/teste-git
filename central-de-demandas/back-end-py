@app.route("/api/solicitacoes", methods=["POST"])
@login_obrigatorio
def api_criar_solicitacao():
    dados = (
        request.form
        if request.form
        else (request.get_json(silent=True) or {})
    )

    usuario = usuario_atual()

    titulo = str(dados.get("titulo", "")).strip()
    descricao = str(dados.get("descricao", "")).strip()
    categoria_id = dados.get("id_categoria")
    prazo_texto = str(dados.get("prazo", "")).strip()

    prioridade = str(
        dados.get("prioridade", "Baixa")
    ).strip().capitalize()

    if not titulo or not descricao:
        return erro_json(
            "Informe o título e a descrição da solicitação."
        )

    if prioridade not in {"Baixa", "Média", "Alta"}:
        prioridade = "Baixa"

    prazo = None

    if prazo_texto:
        try:
            prazo = date.fromisoformat(prazo_texto)
        except ValueError:
            return erro_json("Data de prazo inválida.")

    arquivos = request.files.getlist("anexos")
    arquivos_validos = []

    for arquivo in arquivos:
        if not arquivo or not arquivo.filename:
            continue

        nome = secure_filename(arquivo.filename)
        extensao = (
            nome.rsplit(".", 1)[-1].lower()
            if "." in nome else ""
        )

        if extensao not in EXTENSOES_PERMITIDAS:
            return erro_json(
                "Formato não permitido. Use PDF, PNG ou JPG."
            )

        arquivos_validos.append((arquivo, nome))

    conexao = None
    cursor = None
    nomes_salvos = []

    try:
        conexao = conectar_banco()
        cursor = conexao.cursor()

        cursor.execute(
            """
            SELECT id_status
            FROM status_solicitacao
            WHERE nome = %s
            LIMIT 1
            """,
            ("Recebido",)
        )

        status = cursor.fetchone()

        if not status:
            return erro_json(
                "Cadastre o status 'Recebido' no banco.",
                500
            )

        categoria = None

        if categoria_id:
            cursor.execute(
                """
                SELECT id_categorias
                FROM categorias
                WHERE id_categorias = %s
                """,
                (categoria_id,)
            )

            categoria = cursor.fetchone()

            if not categoria:
                return erro_json("Categoria inválida.")

        protocolo = gerar_protocolo(cursor)

        cursor.execute(
            """
            INSERT INTO solicitacao (
                protocolo,
                titulo,
                descricao,
                data_criacao,
                prazo,
                prioridade,
                id_usuario,
                id_categoria,
                id_status
            )
            VALUES (%s, %s, %s, NOW(), %s, %s, %s, %s, %s)
            """,
            (
                protocolo,
                titulo,
                descricao,
                prazo,
                prioridade,
                usuario["id_usuarios"],
                categoria[0] if categoria else None,
                status[0]
            )
        )

        id_solicitacao = cursor.lastrowid

        cursor.execute(
            """
            INSERT INTO historico_status (
                data_alteracao,
                observacao,
                id_solicitacao,
                id_status,
                id_usuario
            )
            VALUES (NOW(), %s, %s, %s, %s)
            """,
            (
                "Solicitação criada.",
                id_solicitacao,
                status[0],
                usuario["id_usuarios"]
            )
        )

        for arquivo, nome_original in arquivos_validos:
            nome_salvo = (
                f"{secrets.token_hex(16)}_{nome_original}"
            )

            caminho = UPLOAD_DIR / nome_salvo
            arquivo.save(caminho)
            nomes_salvos.append(caminho)

            tamanho = caminho.stat().st_size

            if tamanho > MAX_UPLOAD_BYTES:
                raise ValueError(
                    "Cada anexo deve ter no máximo 10 MB."
                )

            cursor.execute(
                """
                INSERT INTO anexos (
                    nome_arquivo,
                    caminho_arquivo,
                    tipo_mime,
                    tamanho_bytes,
                    id_solicitacao
                )
                VALUES (%s, %s, %s, %s, %s)
                """,
                (
                    nome_original,
                    nome_salvo,
                    arquivo.mimetype or "application/octet-stream",
                    tamanho,
                    id_solicitacao
                )
            )

        conexao.commit()

        return jsonify({
            "sucesso": True,
            "mensagem": "Solicitação registrada.",
            "protocolo": protocolo
        }), 201

    except ValueError as exc:
        if conexao:
            conexao.rollback()

        for caminho in nomes_salvos:
            caminho.unlink(missing_ok=True)

        return erro_json(str(exc))

    except Error:
        if conexao:
            conexao.rollback()

        for caminho in nomes_salvos:
            caminho.unlink(missing_ok=True)

        app.logger.exception("Falha ao criar solicitação.")

        return erro_json(
            "Não foi possível registrar a solicitação.",
            500
        )

    finally:
        if cursor:
            cursor.close()

        if conexao:
            conexao.close()

@app.route(
    "/api/solicitacoes/<path:protocolo>",
    methods=["GET"]
)
