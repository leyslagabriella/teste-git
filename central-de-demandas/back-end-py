@app.route("/")
def index():
  return render_template("index.html")


@app.route("/api/login", methods=["POST"])
def api_login():
  dados = request.get_json() or {}
  matricula = dados.get("matricula", "").strip()
  senha = dados.get("senha", "").strip()

  if not matricula or not senha:
    return (
        jsonify({"sucesso": False, "erro": "Preencha a matrícula e a senha."}),
        400,
    )

  return jsonify({
      "sucesso": True,
      "mensagem": "Login efetuado com sucesso!",
      "usuario": matricula,
  })


@app.route("/api/solicitacoes/<protocolo>", methods=["GET"])
def api_obter_solicitacao(protocolo):
  protocolo = f"#{protocolo}" if not protocolo.startswith("#") else protocolo
  solicitacao = SOLICITACOES_DB.get(protocolo)

  if not solicitacao:
    return jsonify({"sucesso": False, "erro": "Protocolo não encontrado."}), 404

  return jsonify({"sucesso": True, "dados": solicitacao})


@app.route("/api/solicitacoes/<protocolo>/chat", methods=["POST"])
def api_enviar_mensagem(protocolo):
  protocolo = f"#{protocolo}" if not protocolo.startswith("#") else protocolo
  if protocolo not in SOLICITACOES_DB:
    return jsonify({"sucesso": False, "erro": "Protocolo não encontrado."}), 404

  dados = request.get_json() or {}
  texto = dados.get("texto", "").strip()

  if not texto:
    return (
        jsonify({"sucesso": False, "erro": "A mensagem não pode estar vazia."}),
        400,
    )

  hora_atual = datetime.now().strftime("%H:%M")
  nova_msg = {"remetente": "Você", "texto": texto, "hora": hora_atual}

  SOLICITACOES_DB[protocolo]["mensagens"].append(nova_msg)
  return jsonify({"sucesso": True, "mensagem": nova_msg})


@app.route("/api/solicitacoes/<protocolo>/resolver", methods=["POST"])
def api_resolver_solicitacao(protocolo):
  protocolo = f"#{protocolo}" if not protocolo.startswith("#") else protocolo
  if protocolo not in SOLICITACOES_DB:
    return jsonify({"sucesso": False, "erro": "Protocolo não encontrado."}), 404

  dados = request.get_json() or {}
  resolvido = dados.get("resolvido", False)

  if resolvido:
    SOLICITACOES_DB[protocolo]["status"] = "Resolvido"
    msg = "Solicitação encerrada com sucesso."
  else:
    SOLICITACOES_DB[protocolo]["status"] = "Em Andamento (Reanálise)"
    msg = "A coordenação foi notificada para reanálise."

  return jsonify({"sucesso": True, "mensagem": msg})


@app.route("/api/coordenacao/metricas", methods=["GET"])
def api_metricas_coordenacao():
