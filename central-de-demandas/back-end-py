@app.route("/api/login", methods=["POST"])
def api_login():
    dados = request.get_json(silent=True) or request.form

    matricula = str(dados.get("matricula", "")).strip()
    senha = str(dados.get("senha", ""))

    if not matricula or not senha:
        return erro_json(
            "Preencha a matrícula e a senha."
        )

    try:
        usuario = executar(
            """
            SELECT
                id_usuarios,
                nome,
                matricula,
                curso,
                turma,
                senha_hash,
                tipo_usuario
            FROM usuarios
            WHERE matricula = %s
            LIMIT 1
            """,
            (matricula,),
            buscar="um"
        )

    except Error:
        app.logger.exception("Falha ao consultar usuário.")
        return erro_json(
            "Não foi possível acessar o banco de dados.",
            500
        )

    if (
        not usuario
        or not check_password_hash(
            usuario["senha_hash"],
            senha
        )
    ):
        return erro_json(
            "Matrícula ou senha incorretas.",
            401
        )

    session.clear()

    session["usuario"] = {
        "id_usuarios": usuario["id_usuarios"],
        "nome": usuario["nome"],
        "matricula": usuario["matricula"],
        "curso": usuario["curso"],
        "turma": usuario["turma"],
        "tipo_usuario": usuario["tipo_usuario"]
    }

    return jsonify({
        "sucesso": True,
        "mensagem": "Login efetuado.",
        "usuario": session["usuario"]
    })

