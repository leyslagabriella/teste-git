@app.route(
    "/api/solicitacoes/<path:protocolo>/resolver",
    methods=["POST"]
)
@login_obrigatorio
def api_resolver_solicitacao(protocolo):
    protocolo = normalizar_protocolo(protocolo)
    dados = request.get_json(silent=True) or {}

    resolvido = bool(dados.get("resolvido", False))
    usuario = usuario_atual()

    try:
        solicitacao = buscar_solicitacao(protocolo)

        if not solicitacao:
            return erro_json(
                "Protocolo não encontrado.",
                404
            )

        if (
            usuario["tipo_usuario"].lower()
            not in {
                "coordenacao",
                "coordenador",
                "admin",
                "administrador"
            }
            and solicitacao["matricula"] != usuario["matricula"]
        ):
            return erro_json(
                "Você não tem permissão para alterar esta solicitação.",
                403
            )

        nome_status = (
            "Resolvido" if resolvido else "Em Andamento"
        )

        status = executar(
            """
            SELECT id_status
            FROM status_solicitacao
            WHERE nome = %s
            LIMIT 1
            """,
            (nome_status,),
            buscar="um"
        )

        if not status:
            return erro_json(
                f"Cadastre o status '{nome_status}' na tabela status_solicitacao.",
                500
            )

        observacao = (
            "Solicitação marcada como resolvida pelo usuário."
            if resolvido
            else "Usuário informou que a solicitação ainda não foi resolvida."
        )

        conexao = conectar_banco()
        cursor = conexao.cursor()

        try:
            cursor.execute(
                """
                UPDATE solicitacao
                SET id_status = %s
                WHERE id_solicitacao = %s
                """,
                (
                    status["id_status"],
                    solicitacao["id_solicitacao"]
                )
            )

            cursor.execute(
                """
                INSERT INTO historico_status (
                    data_alteracao,
                    observacao,
                    id_solicitacao,
                    id_status,
                    id_usuario
                )
                VALUES (NOW(), %s, %s, %s, %s)
                """,
                (
                    observacao,
                    solicitacao["id_solicitacao"],
                    status["id_status"],
                    usuario["id_usuarios"]
                )
            )

            conexao.commit()

        except Exception:
            conexao.rollback()
            raise

        finally:
            cursor.close()
            conexao.close()

        return jsonify({
            "sucesso": True,
            "mensagem": (
                "Solicitação atualizada."
                if resolvido
                else "Solicitação encaminhada para reanálise."
            )
        })

    except Error:
        app.logger.exception("Falha ao atualizar status.")

        return erro_json(
            "Não foi possível atualizar o status.",
            500
        )

@app.route(
    "/api/coordenacao/metricas",
    methods=["GET"]
)
@coordenacao_obrigatoria
def api_metricas_coordenacao():
    try:
        resumo = executar(
            """
            SELECT
                SUM(
                    CASE
                        WHEN LOWER(st.nome) NOT IN (
                            'resolvido',
                            'resolvida',
                            'encerrado',
                            'encerrada'
                        )
                        THEN 1 ELSE 0
                    END
                ) AS abertas,

                SUM(
                    CASE
                        WHEN s.prioridade = 'Alta'
                        AND LOWER(st.nome) NOT IN (
                            'resolvido',
                            'resolvida',
                            'encerrado',
                            'encerrada'
                        )
                        THEN 1 ELSE 0
                    END
                ) AS alta_prioridade,

                SUM(
                    CASE
                        WHEN s.prioridade = 'Média'
                        AND LOWER(st.nome) NOT IN (
                            'resolvido',
                            'resolvida',
                            'encerrado',
                            'encerrada'
                        )
                        THEN 1 ELSE 0
                    END
                ) AS media_prioridade,

                SUM(
                    CASE
                        WHEN s.prioridade = 'Baixa'
                        AND LOWER(st.nome) NOT IN (
                            'resolvido',
                            'resolvida',
                            'encerrado',
                            'encerrada'
                        )
                        THEN 1 ELSE 0
                    END
                ) AS baixa_prioridade,

                SUM(
                    CASE
                        WHEN LOWER(st.nome) LIKE '%andamento%'
                        THEN 1 ELSE 0
                    END
                ) AS em_andamento,

                SUM(
                    CASE
                        WHEN LOWER(st.nome) IN (
                            'resolvido',
                            'resolvida',
                            'encerrado',
                            'encerrada'
                        )
                        AND DATE(s.data_criacao) = CURDATE()
                        THEN 1 ELSE 0
                    END
                ) AS resolvidas_hoje

            FROM solicitacao s
            LEFT JOIN status_solicitacao st
                ON st.id_status = s.id_status
            """,
            buscar="um"
        ) or {}

        fila = executar(
            """
            SELECT
                s.protocolo AS codigo,
                s.titulo,
                s.prioridade,
                s.prazo,
                s.data_criacao,
                u.nome AS aluno,
                c.nome AS categoria,
                st.nome AS status
            FROM solicitacao s
            JOIN usuarios u
                ON u.id_usuarios = s.id_usuario
            LEFT JOIN categorias c
                ON c.id_categorias = s.id_categoria
            LEFT JOIN status_solicitacao st
                ON st.id_status = s.id_status
            WHERE LOWER(COALESCE(st.nome, 'recebido'))
                NOT IN (
                    'resolvido',
                    'resolvida',
                    'encerrado',
                    'encerrada'
                )
            ORDER BY
                FIELD(s.prioridade, 'Alta', 'Média', 'Baixa'),
                s.prazo IS NULL,
                s.prazo ASC,
                s.data_criacao ASC
            """,
            buscar="todos"
        ) or []

        for item in fila:
            if item.get("prazo"):
                item["prazo"] = item["prazo"].isoformat()

            if item.get("data_criacao"):
                item["data_criacao"] = (
                    item["data_criacao"].isoformat(sep=" ")
                )

        kpis = {
            chave: int(valor or 0)
            for chave, valor in resumo.items()
        }

        return jsonify({
            "sucesso": True,
            "kpis": kpis,
            "fila_inteligente": fila
        })

    except Error:
        app.logger.exception(
            "Falha ao carregar painel da coordenação."
        )

        return erro_json(
            "Não foi possível carregar as métricas.",
            500
        )

@app.route(
    "/api/solicitacoes/<path:protocolo>/status",
    methods=["PATCH"]
)
@coordenacao_obrigatoria
def api_atualizar_status(protocolo):
    protocolo = normalizar_protocolo(protocolo)
    dados = request.get_json(silent=True) or {}

    nome_status = str(
        dados.get("status", "")
    ).strip()

    observacao = (
        str(dados.get("observacao", "")).strip()
        or "Status atualizado pela coordenação."
    )

    try:
        solicitacao = buscar_solicitacao(protocolo)

        if not solicitacao:
            return erro_json(
                "Protocolo não encontrado.",
                404
            )

        status = executar(
            """
            SELECT id_status
            FROM status_solicitacao
            WHERE nome = %s
            LIMIT 1
            """,
            (nome_status,),
            buscar="um"
        )

        if not status:
            return erro_json(
                "Status não encontrado no banco de dados."
            )

        conexao = conectar_banco()
        cursor = conexao.cursor()

        try:
            cursor.execute(
                """
                UPDATE solicitacao
                SET id_status = %s
                WHERE id_solicitacao = %s
                """,
                (
                    status["id_status"],
                    solicitacao["id_solicitacao"]
                )
            )

            cursor.execute(
                """
                INSERT INTO historico_status (
                    data_alteracao,
                    observacao,
                    id_solicitacao,
                    id_status,
                    id_usuario
                )
                VALUES (NOW(), %s, %s, %s, %s)
                """,
                (
                    observacao,
                    solicitacao["id_solicitacao"],
                    status["id_status"],
                    usuario_atual()["id_usuarios"]
                )
            )

            conexao.commit()

        except Exception:
            conexao.rollback()
            raise

        finally:
            cursor.close()
            conexao.close()

        return jsonify({
            "sucesso": True,
            "mensagem": "Status atualizado."
        })

    except Error:
        app.logger.exception("Falha ao atualizar status.")

        return erro_json(
            "Não foi possível atualizar o status.",
            500
        )

@app.route(
    "/api/anexos/<int:id_anexo>/download",
    methods=["GET"]
)
@login_obrigatorio
def api_baixar_anexo(id_anexo):
    try:
        anexo = executar(
            """
            SELECT
                a.nome_arquivo,
                a.caminho_arquivo,
                s.id_usuario,
                u.matricula
            FROM anexos a
            JOIN solicitacao s
                ON s.id_solicitacao = a.id_solicitacao
            JOIN usuarios u
                ON u.id_usuarios = s.id_usuario
            WHERE a.id_anexos = %s
            LIMIT 1
            """,
            (id_anexo,),
            buscar="um"
        )

        if not anexo:
            return erro_json(
                "Anexo não encontrado.",
                404
            )

        usuario = usuario_atual()

        if (
            usuario["tipo_usuario"].lower()
            not in {
                "coordenacao",
                "coordenador",
                "admin",
                "administrador"
            }
            and anexo["matricula"] != usuario["matricula"]
        ):
            return erro_json(
                "Você não tem permissão para baixar este arquivo.",
                403
            )

        return send_from_directory(
            UPLOAD_DIR,
            anexo["caminho_arquivo"],
            as_attachment=True,
            download_name=anexo["nome_arquivo"]
        )

    except Error:
        app.logger.exception("Falha ao consultar anexo.")

        return erro_json(
            "Não foi possível baixar o anexo.",
            500
        )

