    function mudarSubAba(tipo) {
      document.getElementById('tab-btn-nova').classList.remove('active');
      document.getElementById('tab-btn-acompanhar').classList.remove('active');
      document.getElementById('secao-nova').classList.remove('active');
      document.getElementById('secao-acompanhar').classList.remove('active');

      if (tipo === 'nova') {
        document.getElementById('tab-btn-nova').classList.add('active');
        document.getElementById('secao-nova').classList.add('active');
      } else {
        document.getElementById('tab-btn-acompanhar').classList.add('active');
        document.getElementById('secao-acompanhar').classList.add('active');
      }
    }

    function ativarChip(btn) {
      btn.parentElement.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('input-nome-categoria').value = btn.innerText.trim();
    }


    function mudarToggle(btn, valor) {
      const group = btn.parentElement;
      const qid = group.getAttribute('data-qid');
      group.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      respostasPrioridade[qid] = valor;
      calcularPrioridade();
    }

    function calcularPrioridade() {
      const valores = Object.values(respostasPrioridade);
      const totalSims = valores.filter(v => v === 'Sim').length;
      const totalNao = valores.filter(v => v === 'Nao').length;
      const labelEl = document.getElementById('label-prioridade');

      if (totalSims >= 2) {
        labelEl.innerText = 'Alta';
        labelEl.style.color = '#ef4444';
      } else if (totalSims === 1 && totalNao === 2) {
        labelEl.innerText = 'Média';
        labelEl.style.color = '#f59e0b';
      } else {
        labelEl.innerText = 'Baixa';
        labelEl.style.color = '#10b981';
      }
    }

    async function buscarProtocolo() {
      const protocolo = document.getElementById('input-protocolo').value.trim();
      const boxResultado = document.getElementById('resultado-protocolo');

      if (!protocolo) {
        alert('Por favor, digite o código do protocolo.');
        return;
      }

      try {
        const resposta = await fetch(`/buscar-protocolo?protocolo=${encodeURIComponent(protocolo)}`);
        const dados = await resposta.json();

        if (!resposta.ok) {
          alert(dados.erro || 'Protocolo não encontrado.');
          boxResultado.classList.add('hidden');
          return;
        }

        document.getElementById('res-id-solicitacao').value = dados.id_solicitacao;
        document.getElementById('res-protocolo').innerText = dados.protocolo;
        document.getElementById('res-prioridade').innerText = dados.prioridade;
        if (dados.coletiva) {
          document.getElementById('res-prioridade').innerText += ' · 👥 Solicitação Coletiva da Turma';
        }
        document.getElementById('res-titulo').innerText = dados.titulo;
        document.getElementById('res-descricao').innerText = dados.descricao;
        const infoCurso = dados.turma ? `${dados.nome_curso} (${dados.turma})` : dados.nome_curso;
        document.getElementById('res-usuario').innerText = `Solicitante: ${dados.nome_usuario} · Curso: ${infoCurso}`;

       // Mostra Editar/Excluir só para Aluno; Alterar Status só para Coordenação
       const boxAluno = document.getElementById('acoes-aluno');
       const boxCoord = document.getElementById('acoes-coordenacao');
       if (perfilUsuarioLogado === 'coordenador') {
       if (boxAluno) boxAluno.style.display = 'none';
       if (boxCoord) boxCoord.style.display = 'flex';
       }  else {
       if (boxAluno) boxAluno.style.display = 'flex';
       if (boxCoord) boxCoord.style.display = 'none';
       }

       
        // Atualiza a Linha do Tempo com status e data/hora reais
        const containerTimeline = document.getElementById('timeline-etapas');
        const datasMap = {};
        (dados.historico || []).forEach(h => { datasMap[h.status_nome] = h.data_fmt; });

        if (containerTimeline && containerTimeline.children.length >= 3) {
        const etapa1 = containerTimeline.children.item(0);
        const etapa2 = containerTimeline.children.item(1);
        const etapa3 = containerTimeline.children.item(2);

        // Etapa 1: Recebido (sempre marcada)
        etapa1.classList.add('active', 'completed');
        const textos1 = etapa1.querySelectorAll('span, small, p');
        if (textos1.length > 0) textos1.item(textos1.length - 1).innerText = datasMap['Recebido'] || dados.data_criacao;

        // Etapa 2: Em Análise (só marca se o status atual for "Em Análise" ou "Resolvida")
        const textos2 = etapa2.querySelectorAll('span, small, p');
        if (dados.nome_status === 'Em Análise' || dados.nome_status === 'Resolvida') {
            etapa2.classList.add('active', 'completed');
          if (textos2.length > 0) textos2.item(textos2.length - 1).innerText = datasMap['Em Análise'] || dados.data_criacao;
        } else {
          etapa2.classList.remove('active', 'completed');
          if (textos2.length > 0) textos2.item(textos2.length - 1).innerText = 'Aguardando';
        }

          // Etapa 3: Resolvida (só marca quando o status atual for "Resolvida")
          const textos3 = etapa3.querySelectorAll('strong, span, small, p');
          if (textos3.length >= 2) textos3.item(0).innerText = 'Resolvida';

          if (dados.nome_status === 'Resolvida') {
            etapa3.classList.add('active', 'completed');
            if (textos3.length > 0) textos3.item(textos3.length - 1).innerText = datasMap['Resolvida'] || dados.data_criacao;
          } else {
            etapa3.classList.remove('active', 'completed');
            if (textos3.length > 0) textos3.item(textos3.length - 1).innerText = 'Aguardando';
          }
        }

        document.getElementById('res-status').innerText = dados.nome_status;
        document.getElementById('res-data').innerText = dados.data_criacao;

        // Carrega as mensagens do banco (Tabela 2: mensagens) com Editar e Excluir
        const chatDiv = document.getElementById('chat-messages');
        chatDiv.innerHTML = '';
        (dados.mensagens || []).forEach(msg => {
         chatDiv.innerHTML += `
            <div class="chat-bubble aluno">
              <strong>${msg.nome}</strong>
              <p>${msg.conteudo}</p>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; padding-top: 4px; border-top: 1px solid rgba(255,255,255,0.2); font-size: 0.72rem;">
                <span style="opacity: 0.85;">${msg.hora}</span>
                <div style="display: flex; gap: 8px;">
                  <a href="#" style="color: #fde047; text-decoration: none; font-weight: 600;" onclick="editarMensagem(${msg.id_mensagem}, '${msg.conteudo.replace(/'/g, "\\'")}'); return false;">✏️ Editar</a>
                  <a href="#" style="color: #fca5a5; text-decoration: none; font-weight: 600;" onclick="excluirMensagem(${msg.id_mensagem}); return false;">🗑️ Excluir</a>
                </div>
              </div>
            </div>`;
        });
        
        const anexosDiv = document.getElementById('lista-anexos-protocolo');
        if (anexosDiv) {
          if (dados.anexos && dados.anexos.length > 0) {
            anexosDiv.innerHTML = '';
            dados.anexos.forEach(anx => {
              anexosDiv.innerHTML += `
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem; border: 1px solid #f3f4f6; border-radius: 8px; margin-bottom: 0.5rem; background: #f9fafb;">
                  <span style="font-size: 0.85rem; color: #374151;">📎 ${anx.nome_arquivo}</span>
                  <a href="/${anx.caminho_arquivo}" target="_blank" style="color: #2563eb; font-size: 0.82rem; font-weight: 600; text-decoration: none;">Abrir / Baixar</a>
                </div>`;
            });
          } else {
            anexosDiv.innerHTML = '<span style="font-size: 0.85rem; color: #6b7280;">Nenhum anexo enviado nesta solicitação.</span>';
          }
        }


        boxResultado.classList.remove('hidden');
      } catch (erro) {
        alert('Erro ao conectar com o servidor.');
      }
    }

    async function editarSolicitacao() {
      const protocolo = document.getElementById('res-protocolo').innerText;
      const atual = document.getElementById('res-descricao').innerText;
      const nova = prompt('Digite a nova descrição da solicitação:', atual);
      if (!nova || nova.trim() === '') return;

      const resp = await fetch('/editar-solicitacao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ protocolo, descricao: nova })
      });
      const dados = await resp.json();
      alert(dados.mensagem || dados.erro);
      if (resp.ok) buscarProtocolo();
    }

    async function excluirSolicitacao() {
      const protocolo = document.getElementById('res-protocolo').innerText;
      if (!confirm(`Tem certeza que deseja excluir a solicitação ${protocolo}?`)) return;

      const resp = await fetch('/excluir-solicitacao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ protocolo })
      });
      const dados = await resp.json();
      alert(dados.mensagem || dados.erro);
      if (resp.ok) {
        document.getElementById('resultado-protocolo').classList.add('hidden');
        document.getElementById('input-protocolo').value = '';
      }
    }

    async function enviarMensagemChat() {
      const id_solicitacao = document.getElementById('res-id-solicitacao').value;
      const txtInput = document.getElementById('chat-txt');
      const conteudo = txtInput.value.trim();
      if (!conteudo) return;

      const resp = await fetch('/mensagens', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_solicitacao, conteudo })
      });
      if (resp.ok) {
        txtInput.value = '';
        buscarProtocolo();
      }
    }

    async function editarMensagem(id_mensagem, textoAtual) {
      const novoTexto = prompt('Editar mensagem:', textoAtual);
      if (!novoTexto || novoTexto.trim() === '') return;

      const resp = await fetch('/mensagens/editar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_mensagem, conteudo: novoTexto })
      });
      if (resp.ok) buscarProtocolo();
    }

    async function excluirMensagem(id_mensagem) {
      if (!confirm('Excluir esta mensagem?')) return;
      const resp = await fetch('/mensagens/excluir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_mensagem })
      });
      if (resp.ok) buscarProtocolo();
    }

    function responderResolucao(resp) {
      const fb = document.getElementById('feedback-resolucao');
      if (resp === 'sim') {
        fb.innerHTML = '<span style="color: #10b981;">Ótimo! Obrigado pelo retorno.<br>Solicitação encerrada com sucesso.</span>';
      } else {
        fb.innerHTML = '<span style="color: #ef4444;">Entendemos. Vamos continuar trabalhando.<br>A coordenação foi notificada para reanálise.</span>';
      }
    }

    function filtrarTabela(prio, btn) {
      document.querySelectorAll('.pill-filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const trs = document.querySelectorAll('#tbody-fila tr');
      trs.forEach(tr => {
        if (prio === 'Todas' || tr.getAttribute('data-prioridade') === prio) {
              tr.style.display = '';
        } else {
          tr.style.display = 'none';
        }
      });
    }

    function mudarGrafico(tipo) {
      document.querySelectorAll('.chart-btn').forEach(b => b.classList.remove('active'));
      if (tipo === 'barras') {
        document.querySelectorAll('.chart-btn')[1].classList.add('active');
        document.getElementById('chart-barras').classList.remove('hidden');
        document.getElementById('chart-pizza').classList.add('hidden');
      } else {
        document.querySelectorAll('.chart-btn')[0].classList.add('active');
        document.getElementById('chart-barras').classList.add('hidden');
        document.getElementById('chart-pizza').classList.remove('hidden');
      }
    }

    function toggleNotificacoes() {
      document.getElementById('popover-notificacoes').classList.toggle('hidden');
    }
        // Carrega automaticamente as solicitações reais do MySQL assim que a página abre
    window.addEventListener('DOMContentLoaded', () => {
      carregarFilaCoordenacao();
    });
   
          let ultimoProtocoloGerado = '';

    async function enviarSolicitacaoBonita(event) {
      event.preventDefault();
      document.getElementById('input-prioridade').value = document.getElementById('label-prioridade').innerText;

      const form = document.getElementById('form-nova-solicitacao');
      const formData = new FormData(form);

      try {
        const resp = await fetch('/salvar-solicitacao', {
          method: 'POST',
          body: formData
        });
        const texto = await resp.text();

        if (!resp.ok) {
          alert(texto);
          return;
        }

        const match = texto.match(/PROT-\d+-\d+/);
        ultimoProtocoloGerado = match ? match : 'Registrado';

        document.getElementById('modal-protocolo-texto').innerText = ultimoProtocoloGerado;
        const modal = document.getElementById('modal-sucesso');
        modal.classList.remove('hidden');
        modal.style.display = 'flex';

        form.reset();
      } catch (erro) {
        alert('Erro ao enviar solicitação.');
      }
    }

    function fecharModalSucesso(irParaAcompanhar) {
      const modal = document.getElementById('modal-sucesso');
      modal.classList.add('hidden');
      modal.style.display = 'none';

      if (irParaAcompanhar && ultimoProtocoloGerado) {
        abrirAbaAluno('acompanhar');
        document.getElementById('input-protocolo').value = ultimoProtocoloGerado;
        buscarProtocolo();
      }
    }
    function alternarTelaAuth(modo) {
      const formLogin = document.getElementById('form-login');
      const formCad = document.getElementById('form-cadastro');
      const titulo = document.getElementById('titulo-auth');
      const sub = document.getElementById('subtitulo-auth');

      if (modo === 'cadastro') {
        formLogin.classList.add('hidden');
        formCad.classList.remove('hidden');
        titulo.innerText = 'Criar Conta';
        sub.innerText = 'Cadastre sua matrícula e senha pessoal';
      } else {
        formCad.classList.add('hidden');
        formLogin.classList.remove('hidden');
        titulo.innerText = 'Central de Demandas';
        sub.innerText = 'Entre com seus dados para continuar';
      }
    }
  
    async function fazerCadastroUsuario(event) {
      event.preventDefault();
      const nome = document.getElementById('cad-nome').value.trim();
      const matricula = document.getElementById('cad-matricula').value.trim();
      const senha = document.getElementById('cad-senha').value.trim();
      const msgBox = document.getElementById('cadastro-msg');

      const resp = await fetch('/cadastrar-usuario', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, matricula, senha })
      });
      const dados = await resp.json();

      msgBox.classList.remove('hidden');
      if (!resp.ok) {
        msgBox.style.background = '#fee2e2';
        msgBox.style.color = '#b91c1c';
        msgBox.innerText = dados.erro;
        return;
      }

      msgBox.style.background = '#dcfce7';
      msgBox.style.color = '#166534';
      msgBox.innerText = dados.mensagem;
      document.getElementById('form-cadastro').reset();

      setTimeout(() => {
        alternarTelaAuth('login');
        document.getElementById('matricula').value = matricula;
        msgBox.classList.add('hidden');
      }, 1500);
    }
    function mostrarNomeAnexo(input) {
      const texto = document.getElementById('texto-anexo-selecionado');
      if (input.files && input.files.length > 0) {
        texto.innerHTML = `📎 Arquivo selecionado: <strong style="color: #15803d;">${input.files[0].name}</strong>`;
      } else {
        texto.innerHTML = `Arraste arquivos ou <strong style="color: #15803d; text-decoration: underline;">clique para selecionar</strong>`;
      }
    }

    async function salvarNovoStatus() {
      const protocolo = document.getElementById('res-protocolo').innerText.trim();
      const status = document.getElementById('select-novo-status').value;

      try {
        const resp = await fetch('/atualizar-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ protocolo, status })
        });
        const dados = await resp.json();

        if (resp.ok) {
          alert('✅ ' + dados.mensagem);
          buscarProtocolo();
        } else {
          alert(dados.erro || 'Erro ao atualizar status.');
        }
      } catch (erro) {
        alert('Erro de conexão ao atualizar status.');
      }
    }

    async function carregarMinhasSolicitacoes() {
      const box = document.getElementById('box-minhas-solicitacoes');
      const listaDiv = document.getElementById('lista-meus-protocolos');
      if (!box || !listaDiv) return;

      // Só exibe essa lista para alunos (coordenação já tem a Fila Inteligente completa)
      if (perfilUsuarioLogado === 'coordenador' || !idUsuarioLogado) {
        box.style.display = 'none';
        return;
      }

      box.style.display = 'block';
      try {
        const resp = await fetch(`/minhas-solicitacoes?id_usuario=${idUsuarioLogado}`);
        const lista = await resp.json();

        if (!lista || lista.length === 0) {
          listaDiv.innerHTML = '<span style="font-size: 0.85rem; color: #6b7280;">Você ainda não possui solicitações registradas.</span>';
          return;
        }

        listaDiv.innerHTML = '';
        lista.forEach(item => {
          listaDiv.innerHTML += `
            <div onclick="selecionarMeuProtocolo('${item.protocolo}')" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; cursor: pointer; transition: border-color 0.2s;">
              <div>
                <strong style="color: #15803d; font-size: 0.88rem;">${item.protocolo}</strong>
                <span style="color: #64748b; font-size: 0.78rem; margin-left: 8px;">• ${item.data_criacao}</span>
                <div style="color: #334155; font-size: 0.85rem; margin-top: 2px;">${item.titulo}</div>
              </div>
              <span style="background: #dcfce7; color: #166534; padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600;">${item.nome_status}</span>
            </div>`;
        });
      } catch (erro) {
        console.error('Erro ao carregar meus protocolos:', erro);
      }
    }

    function selecionarMeuProtocolo(protocolo) {
      document.getElementById('input-protocolo').value = protocolo;
      buscarProtocolo();
    }



  </script>
