                  <td>
                    <button class="btn-tb-abrir" onclick="abrirAbaAluno('acompanhar')">Abrir</button>
                    <button class="btn-tb-resp" onclick="alert('Responder solicitação #2026-022')">Responder</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="coord-card">
          <div class="coord-card-header">
            <h3>Tipos de Problema</h3>
            <div class="toggle-chart">
              <button class="chart-btn" onclick="mudarGrafico('pizza')">Pizza</button>
              <button class="chart-btn active" onclick="mudarGrafico('barras')">Barras</button>
            </div>
          </div>

          <div id="chart-barras" class="bar-chart-sim">
            <div class="chart-bars-wrapper">
              <div class="bar-col"><div class="bar dark" style="height: 60%;"></div><div class="bar light" style="height: 35%;"></div><span>Seg</span></div>
              <div class="bar-col"><div class="bar dark" style="height: 80%;"></div><div class="bar light" style="height: 50%;"></div><span>Ter</span></div>
              <div class="bar-col"><div class="bar dark" style="height: 45%;"></div><div class="bar light" style="height: 40%;"></div><span>Qua</span></div>
              <div class="bar-col"><div class="bar dark" style="height: 95%;"></div><div class="bar light" style="height: 65%;"></div><span>Qui</span></div>
              <div class="bar-col"><div class="bar dark" style="height: 70%;"></div><div class="bar light" style="height: 45%;"></div><span>Sex</span></div>
            </div>
            <div class="chart-legend">
              <span><strong class="sq dark"></strong> Abertas</span>
              <span><strong class="sq light"></strong> Resolvidas</span>
            </div>
          </div>

          <div id="chart-pizza" class="pizza-chart-sim hidden">
            <div class="donut-ring"></div>
            <ul class="pizza-legend">
              <li><span>• Matrícula</span> <strong>35%</strong></li>
              <li><span>• Documentação</span> <strong>25%</strong></li>
              <li><span>• Horários</span> <strong>20%</strong></li>
              <li><span>• Estrutura</span> <strong>12%</strong></li>
              <li><span>• Outros</span> <strong>8%</strong></li>
            </ul>
          </div>

          <div class="semana-atual-box">
            <span class="sa-title">SEMANA ATUAL</span>
            <div class="sa-grid">
              <div><strong class="sa-val">37</strong><small>Resolvidas</small></div>
              <div><strong class="sa-val">50</strong><small>Novas</small></div>
              <div><strong class="sa-val">74%</strong><small>Taxa resolução</small></div>
              <div><strong class="sa-val">2.3h</strong><small>Tempo médio</small></div>
            </div>
          </div>
        </div>

      </div>

    </main>

    <footer>Instituto Federal do Piauí — Central de Demandas da Coordenação</footer>
  </div>

  <script>
    const respostasPrioridade = { q1: 'Nao', q2: 'Nao', q3: 'Nao' };

    function fazerLogin(event) {
      event.preventDefault();
      const mat = document.getElementById('matricula').value.trim();
      const sen = document.getElementById('senha').value.trim();
      const errBox = document.getElementById('login-erro');

      if (mat === '' || sen === '') {
        errBox.innerText = 'Preencha a matrícula e a senha para entrar!';
        errBox.classList.remove('hidden');
        return;
      }

      errBox.classList.add('hidden');
      document.getElementById('global-header').classList.remove('hidden');
      navegarPara('dashboard-page');
    }

    function fazerLogout() {
      document.getElementById('global-header').classList.add('hidden');
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('login-page').classList.add('active');
      document.getElementById('matricula').value = '';
      document.getElementById('senha').value = '';
    }

    function navegarPara(pageId) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');

      document.getElementById('nav-home').classList.remove('active');
      document.getElementById('nav-aluno').classList.remove('active');
      document.getElementById('nav-coord').classList.remove('active');

      if (pageId === 'dashboard-page') {
        document.getElementById('nav-home').classList.add('active');
      } else if (pageId === 'aluno-page') {
        document.getElementById('nav-aluno').classList.add('active');
      } else if (pageId === 'coordenacao-page') {
        document.getElementById('nav-coord').classList.add('active');
      }
    }

    function abrirAbaAluno(tipo) {
      navegarPara('aluno-page');
      mudarSubAba(tipo);
      if (tipo === 'acompanhar') {
        document.getElementById('input-protocolo').value = '#2026-015';
        buscarProtocolo();
      }
    }

    function mudarSubAba(tipo) {
      document.getElementById('tab-btn-nova').classList.remove('active');
      document.getElementById('tab-btn-acompanhar').classList.remove('active');
      document.getElementById('secao-nova').classList.remove('active');
      document.getElementById('secao-acompanhar').classList.remove('active');

      if (tipo === 'nova') {
        document.getElementById('tab-btn-nova').classList.add('active');
        document.getElementById('secao-nova').classList.add('active');
      } else {
        document.getElementById('tab-btn-acompanhar').classList.add('active');
        document.getElementById('secao-acompanhar').classList.add('active');
      }
    }

    function ativarChip(btn) {
      btn.parentElement.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
    }

    function mudarToggle(btn, valor) {
      const group = btn.parentElement;
      const qid = group.getAttribute('data-qid');
      group.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      respostasPrioridade[qid] = valor;
      calcularPrioridade();
    }

    function calcularPrioridade() {
      const valores = Object.values(respostasPrioridade);
      const totalSims = valores.filter(v => v === 'Sim').length;
      const totalNao = valores.filter(v => v === 'Nao').length;
      const labelEl = document.getElementById('label-prioridade');

      if (totalSims >= 2) {
        labelEl.innerText = 'Alta';
        labelEl.style.color = '#ef4444';
      } else if (totalSims === 1 && totalNao === 2) {
        labelEl.innerText = 'Média';
        labelEl.style.color = '#f59e0b';
      } else {
        labelEl.innerText = 'Baixa';
        labelEl.style.color = '#10b981';
      }
    }

    function enviarFormulario(e) {
      e.preventDefault();
      alert('Solicitação enviada com sucesso! Protocolo gerado: #2026-015');
      abrirAbaAluno('acompanhar');
    }

    function buscarProtocolo() {
      const val = document.getElementById('input-protocolo').value.trim();
      const resBox = document.getElementById('resultado-protocolo');
      if (val === '#2026-015') {
        resBox.classList.remove('hidden');
      } else {
        alert('Protocolo não encontrado. Tente: #2026-015');
        resBox.classList.add('hidden');
      }
    }

    function enviarMensagemChat() {
      const txtInput = document.getElementById('chat-txt');
      const txt = txtInput.value.trim();
      if (!txt) return;

      const chatMsgs = document.getElementById('chat-messages');
      const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      chatMsgs.innerHTML += `
        <div class="chat-bubble aluno">
          <strong>Você</strong>
          <p>${txt}</p>
          <span class="time">${timeNow}</span>
        </div>
      `;
      txtInput.value = '';
      chatMsgs.scrollTop = chatMsgs.scrollHeight;
    }

    function responderResolucao(resp) {
      const fb = document.getElementById('feedback-resolucao');
      if (resp === 'sim') {
        fb.innerHTML = '<span style="color: #10b981;">Ótimo! Obrigado pelo retorno.<br>Solicitação encerrada com sucesso.</span>';
      } else {
        fb.innerHTML = '<span style="color: #ef4444;">Entendemos. Vamos continuar trabalhando.<br>A coordenação foi notificada para reanálise.</span>';
      }
    }

    function filtrarTabela(prio, btn) {
      document.querySelectorAll('.pill-filter').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const trs = document.querySelectorAll('#tbody-fila tr');
      trs.forEach(tr => {
        if (prio === 'Todas' || tr.getAttribute('data-prioridade') === prio) {
          tr.style.display = '';
        } else {
          tr.style.display = 'none';
        }
      });
    }

    function mudarGrafico(tipo) {
      document.querySelectorAll('.chart-btn').forEach(b => b.classList.remove('active'));
      if (tipo === 'barras') {
        document.querySelectorAll('.chart-btn')[1].classList.add('active');
        document.getElementById('chart-barras').classList.remove('hidden');
        document.getElementById('chart-pizza').classList.add('hidden');
      } else {
        document.querySelectorAll('.chart-btn')[0].classList.add('active');
        document.getElementById('chart-barras').classList.add('hidden');
        document.getElementById('chart-pizza').classList.remove('hidden');
      }
    }

    function toggleNotificacoes() {
      document.getElementById('popover-notificacoes').classList.toggle('hidden');
    }
  </script>
</body>
</html>
