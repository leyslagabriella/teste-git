  <script>

    let perfilUsuarioLogado = 'aluno'; // coloque logo no início do <script>
    let idUsuarioLogado = null;

    function mostrarToast(mensagem, tipo = 'sucesso') {
      const toast = document.getElementById('toast-notificacao');
      const icone = document.getElementById('toast-icone');
      const texto = document.getElementById('toast-texto');

      // Remove emojis duplicados do começo se já vierem no texto
      const textoLimpo = mensagem.replace(/^[✅⚠️❌]\s*/, '');
      texto.innerText = textoLimpo;

      if (tipo === 'erro' || mensagem.includes('Erro') || mensagem.includes('⚠️')) {
        toast.style.borderLeftColor = '#dc2626';
        icone.innerText = '⚠️';
      } else {
        toast.style.borderLeftColor = '#16a34a';
        icone.innerText = '✅';
      }

      toast.style.display = 'flex';
      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, 3800);
    }

    // Faz qualquer alert() do sistema usar o Toast moderno automaticamente!
    window.alert = function(msg) {
      mostrarToast(msg);
    };


    const respostasPrioridade = { q1: 'Nao', q2: 'Nao', q3: 'Nao' };

     async function fazerLogin(event) {
      event.preventDefault();
      const mat = document.getElementById('matricula').value.trim();
      const sen = document.getElementById('senha').value.trim();
      const errBox = document.getElementById('login-erro');

      if (!mat || !sen) {
        errBox.innerText = 'Preencha a matrícula e a senha para entrar!';
        errBox.classList.remove('hidden');
        return;
      }

      try {
        const resp = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ matricula: mat, senha: sen })
        });
        const dados = await resp.json();

        if (!resp.ok) {
          errBox.innerText = dados.erro || 'Matrícula ou senha incorretas!';
          errBox.classList.remove('hidden');
          return;
        }
        perfilUsuarioLogado = dados.tipo_usuario;
        errBox.classList.add('hidden');
        const header = document.getElementById('global-header');
        if (header) header.classList.remove('hidden');
        idUsuarioLogado = dados.id_usuario;
        carregarMinhasSolicitacoes();


        const btnAluno = document.getElementById('nav-aluno');
        const btnCoord = document.getElementById('nav-coord');
        const cardsInicio = document.querySelectorAll('#dashboard-page .action-card');
        const tabNova = document.getElementById('tab-btn-nova');

        if (dados.tipo_usuario === 'coordenador') {
          if (btnCoord) btnCoord.style.display = 'inline-block';
          if (btnAluno) btnAluno.style.display = 'none';
          if (tabNova) tabNova.style.display = 'none';
          if (cardsInicio.length >= 3) {
            cardsInicio[0].style.display = 'none';
            cardsInicio[1].style.display = 'block';
            cardsInicio[2].style.display = 'block';
          }
          navegarPara('coordenacao-page');
        } else {
          if (btnCoord) btnCoord.style.display = 'none';
          if (btnAluno) btnAluno.style.display = 'inline-block';
          if (tabNova) tabNova.style.display = 'inline-block';
          if (cardsInicio.length >= 3) {
            cardsInicio[0].style.display = 'block';
            cardsInicio[1].style.display = 'block';
            cardsInicio[2].style.display = 'none';
          }
          navegarPara('dashboard-page');
        }
      } catch (erro) {
        console.error('Erro no login:', erro);
        errBox.innerText = 'Falha: ' + erro.message;
        errBox.classList.remove('hidden');
      }
    }



    function fazerLogout() {
      document.getElementById('global-header').classList.add('hidden');
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('login-page').classList.add('active');
      document.getElementById('matricula').value = '';
      document.getElementById('senha').value = '';
    }

    function navegarPara(pageId) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');

      document.getElementById('nav-home').classList.remove('active');
      document.getElementById('nav-aluno').classList.remove('active');
      document.getElementById('nav-coord').classList.remove('active');

      if (pageId === 'dashboard-page') {
        document.getElementById('nav-home').classList.add('active');
      } else if (pageId === 'aluno-page') {
        document.getElementById('nav-aluno').classList.add('active');
      } else if (pageId === 'coordenacao-page') {
        document.getElementById('nav-coord').classList.add('active');
        carregarFilaCoordenacao();
      }
    }

        async function carregarFilaCoordenacao() {
      try {
        const resp = await fetch('/listar-solicitacoes');
        const lista = await resp.json();
        const tbody = document.getElementById('tbody-fila');
        tbody.innerHTML = '';

        // Contadores reais calculados direto do banco
        let totalAbertas = 0;
        let totalAlta = 0;
        let totalMedia = 0;
        let totalBaixa = 0;
        let totalAndamento = 0;
        let totalResolvidas = 0;

        lista.forEach(item => {
          // Soma nas estatísticas reais
          if (item.nome_status === 'Resolvida' || item.nome_status === 'Encerrada') {
            totalResolvidas++;
          } else {
            totalAbertas++;
            if (item.nome_status === 'Em Análise') totalAndamento++;
          }

          if (item.prioridade === 'Alta') totalAlta++;
          else if (item.prioridade === 'Média') totalMedia++;
          else totalBaixa++;

          // Monta a linha na tabela Fila Inteligente
          const classePrio = item.prioridade === 'Alta' ? 'alta' : (item.prioridade === 'Média' ? 'media' : 'baixa');
          const seloColetiva = item.coletiva ? `<br><span class="badge-coletiva">👥 Coletiva (${item.turma || 'Turma'})</span>` : '';
          tbody.innerHTML += `
            <tr data-prioridade="${item.prioridade}">
              <td><strong>${item.protocolo}</strong></td>
              <td><strong>${item.nome_usuario}</strong><br><small>${item.titulo}</small>${seloColetiva}</td>
              <td>${item.nome_categoria}</td>
              <td><span class="badge-prio ${classePrio}">• ${item.prioridade}</span></td>
              <td><span class="badge-st recebido">${item.nome_status}</span></td>
              <td>
                <button class="btn-tb-abrir" onclick="abrirSolicitacaoPainel('${item.protocolo}')">Abrir</button>
              </td>
            </tr>`;
        });

        // Atualiza os 6 quadrados de cima (KPIs) no Painel da Coordenação
        const kpis = document.querySelectorAll('#coordenacao-page .kpi-val');
        if (kpis.length >= 6) {
          kpis[0].innerText = totalAbertas;
          kpis[1].innerText = totalAlta;
          kpis[2].innerText = totalMedia;
          kpis[3].innerText = totalBaixa;
          kpis[4].innerText = totalAndamento;
          kpis[5].innerText = totalResolvidas;
        }

        // Atualiza também os 4 quadrados da Página Inicial (Dashboard)
        const statsInicio = document.querySelectorAll('#dashboard-page .stat-item .number');
        if (statsInicio.length >= 4) {
          statsInicio[0].innerText = totalAbertas;
          statsInicio[1].innerText = totalAlta;
          statsInicio[2].innerText = totalAndamento;
          statsInicio[3].innerText = totalResolvidas;
        }

        // Atualiza o texto do banner vermelho de alerta
        const bannerTitulo = document.querySelector('#coordenacao-page .alert-content strong');
        const bannerSub = document.querySelector('#coordenacao-page .alert-content p');
        if (bannerTitulo) bannerTitulo.innerText = `Demandas registradas — ${totalAbertas} solicitações aguardando resposta`;
        if (bannerSub) bannerSub.innerText = `${totalAlta} com alta prioridade · ${totalMedia} com média prioridade · ${totalBaixa} com baixa prioridade`;

      } catch (erro) {
        console.error('Erro ao carregar fila:', erro);
      }
    }


    function abrirSolicitacaoPainel(protocolo) {
      abrirAbaAluno('acompanhar');
      document.getElementById('input-protocolo').value = protocolo;
      buscarProtocolo();
