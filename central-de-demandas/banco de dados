CREATE DATABASE IF NOT EXISTS central_demandas
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE central_demandas;

CREATE TABLE cursos (
    id_curso INT AUTO_INCREMENT PRIMARY KEY,
    nome_curso VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE usuarios (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    matricula VARCHAR(20) NOT NULL UNIQUE,
    senha_hash VARCHAR(255) NOT NULL,
    tipo_usuario VARCHAR(20) NOT NULL,
    id_curso INT NULL,
    turma VARCHAR(30) NULL,
    FOREIGN KEY (id_curso) REFERENCES cursos(id_curso)
);

CREATE TABLE categorias (
    id_categoria INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL UNIQUE,
    descricao TEXT NULL
);

CREATE TABLE status_solicitacao (
    id_status INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(50) NOT NULL UNIQUE,
    descricao TEXT NULL
);

CREATE TABLE solicitacoes (
    id_solicitacao INT AUTO_INCREMENT PRIMARY KEY,
    protocolo VARCHAR(30) NOT NULL UNIQUE,
    titulo VARCHAR(150) NOT NULL,
    descricao TEXT NOT NULL,
    data_criacao DATETIME DEFAULT CURRENT_TIMESTAMP,
    prazo DATE NULL,
    prioridade VARCHAR(20) DEFAULT 'media',
    coletiva BOOLEAN DEFAULT FALSE,
    id_usuario INT NOT NULL,
    id_categoria INT NOT NULL,
    id_status INT NOT NULL,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario),
    FOREIGN KEY (id_categoria) REFERENCES categorias(id_categoria),
    FOREIGN KEY (id_status) REFERENCES status_solicitacao(id_status)
);

CREATE TABLE mensagens (
    id_mensagem INT AUTO_INCREMENT PRIMARY KEY,
    conteudo TEXT NOT NULL,
    data_envio DATETIME DEFAULT CURRENT_TIMESTAMP,
    id_usuario INT NOT NULL,
    id_solicitacao INT NOT NULL,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario),
    FOREIGN KEY (id_solicitacao) REFERENCES solicitacoes(id_solicitacao)
);

CREATE TABLE historico_status (
    id_historico INT AUTO_INCREMENT PRIMARY KEY,
    data_alteracao DATETIME DEFAULT CURRENT_TIMESTAMP,
    observacao TEXT NULL,
    id_solicitacao INT NOT NULL,
    id_status INT NOT NULL,
    id_usuario INT NOT NULL,
    FOREIGN KEY (id_solicitacao) REFERENCES solicitacoes(id_solicitacao),
    FOREIGN KEY (id_status) REFERENCES status_solicitacao(id_status),
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario)
);

CREATE TABLE anexos (
    id_anexo INT AUTO_INCREMENT PRIMARY KEY,
    nome_arquivo VARCHAR(255) NOT NULL,
    caminho_arquivo VARCHAR(500) NOT NULL,
    data_envio DATETIME DEFAULT CURRENT_TIMESTAMP,
    id_solicitacao INT NOT NULL,
    id_usuario INT NOT NULL,
    FOREIGN KEY (id_solicitacao) REFERENCES solicitacoes(id_solicitacao),
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario)
);

